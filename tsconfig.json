{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    
    /* TypeORM Decorator Requirements */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    
    /* Strictness & Compatibility */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}